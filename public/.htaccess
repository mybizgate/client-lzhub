# Vue Router history mode on Apache/cPanel shared hosting: serve index.html for any
# path that is not a real file or directory, so deep links and refreshes work.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
# Hashed assets are immutable; index.html must always be revalidated.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|png|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
