# Copy to .env.local for personal overrides (gitignored). Never put secrets here: every
# VITE_* value is embedded in the public JavaScript bundle.
VITE_CLIENT_CODE=lzhub
VITE_DATA_MODE=local            # local | api

# Business data (tenants, products, orders ...) comes from client-api.
VITE_API_BASE_URL=https://client-api.mybizgate.com/api/v1
# Files and images come from media-api.
VITE_MEDIA_API_BASE_URL=https://media-api.mybizgate.com/api/v1

VITE_SITE_URL=https://lzhub.mybizgate.com
